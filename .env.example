# Copy to .env  (cp .env.example .env). Never commit real secrets.

# --- LLM (OpenAI-compatible chat completions endpoint, e.g. llama-server on Kaggle via cloudflared) ---
# These only SEED data/llm_config.json on first run. After that, change the LLM from the dashboard
# gear icon (no restart needed) - the tunnel URL changes every time the notebook restarts.
LLM_BASE_URL=https://YOUR-KAGGLE-TUNNEL-URL.trycloudflare.com/v1
LLM_API_KEY=changeme
LLM_MODEL=qwen3.6-35b-a3b
LLM_TIMEOUT_SECONDS=10
LLM_ENABLED=false                 # false = pure canned/offline analyst mode

# --- Security gateway ---
ADMIN_TOKEN=dev-admin-token       # shared secret gateway <-> monitor <-> dashboard admin actions
BAN_THRESHOLD=6                   # cumulative risk score that makes an attacker ban-eligible
MAX_HONEYPOT_ACTIONS=8            # kick-out (session end + ban) after N honeypot actions
BAN_IDLE_SECONDS=90               # ban-eligible attacker idle this long -> session ends + ban
TRUST_XFF=true                    # demo setting: trust X-Forwarded-For for client IP
